#!/usr/bin/env python3
#
# router-intake [--limit N] — new Meta Trac bug tickets the router should place this run, one JSON object per line.
#
# Only tickets filed after the pipeline started count: the first run records the newest ticket
# number as a baseline and places nothing. After that, each run picks up open defect tickets above
# the baseline it has not placed yet, and baseline tickets that changed since they were placed (a
# new comment can move or unblock them). Tickets in a skipped component are recorded as skipped
# here, with no model involved. Prints nothing when there is nothing to do.
#
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime

BIN = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(BIN)
STATE_DIR = os.environ.get('WPORG_STATE_DIR', os.path.expanduser('~/.wporg-state'))


def trac(tool, args):
	out = subprocess.run([os.path.join(BIN, 'trac'), tool, json.dumps(args)], capture_output=True, text=True)
	if out.returncode != 0:
		sys.exit(out.stderr.strip())
	return json.loads(out.stdout)


def state(*args):
	return subprocess.run([os.path.join(BIN, 'state'), *args], capture_output=True, text=True, check=True).stdout


def read_route(ticket):
	try:
		with open(os.path.join(STATE_DIR, f'items/trac-{ticket}/route.json')) as f:
			return json.load(f)
	except (FileNotFoundError, json.JSONDecodeError):
		return None


def routed(ticket):
	return read_route(ticket) is not None


def main():
	limit = int(sys.argv[sys.argv.index('--limit') + 1]) if '--limit' in sys.argv else 15
	with open(os.path.join(ROOT, 'routing.json')) as f:
		skip = set(json.load(f)['skip'])
	started = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

	baseline = json.loads(state('get', 'baselines/router.json') or '{}').get('ticket')
	if baseline is None:
		newest = trac('searchTickets', {'query': 'order=id&desc=1', 'limit': 1})['results']
		state('put', 'baselines/router.json', json.dumps({'ticket': newest[0]['id'] if newest else 0, 'since': started}))
		state('put', 'runs/router.json', json.dumps({'last_run': started}))
		return
	run = json.loads(state('get', 'runs/router.json') or '{}')

	picked = []
	res = trac('searchTickets', {'query': 'status!=closed&type=defect (bug)&order=id&desc=1', 'limit': 50})
	for r in res.get('results', []):
		t = r['id']
		if t <= baseline or routed(t):
			continue
		if r['metadata'].get('component') in skip:
			state('put', f'items/trac-{t}/route.json', json.dumps({
				'repo': None, 'status': 'skip', 'summary': r['title'], 'reason': 'out of scope',
			}))
			continue
		picked.append({'ticket': t, 'reason': 'new'})

	if run.get('last_run'):
		since = datetime.fromisoformat(run['last_run'].replace('Z', '+00:00')) - timedelta(days=1)
		for e in trac('getTimeline', {'from': since.strftime('%Y-%m-%d')}).get('results', []):
			m = re.search(r'/ticket/(\d+)', e.get('url', ''))
			if not m:
				continue
			t = int(m.group(1))
			route = read_route(t)
			if t <= baseline or not route or any(p['ticket'] == t for p in picked):
				continue
			# Placed after this event already: the overlap window would otherwise bring it back every run.
			when = parsedate_to_datetime(e['metadata']['date']) if e.get('metadata', {}).get('date') else None
			if when and datetime.fromisoformat(route['updated'].replace('Z', '+00:00')) >= when:
				continue
			picked.append({'ticket': t, 'reason': 'changed'})

	state('put', 'runs/router.json', json.dumps({'last_run': started}))
	for p in picked[:limit]:
		print(json.dumps(p))


main()
