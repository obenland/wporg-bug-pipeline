#!/usr/bin/env bash
#
# cloud-setup [<repo>] — per-session setup inside a Claude Code cloud VM, run first by every routine.
#
# - Guards every checkout with a pre-push hook that refuses any ref outside claude/*.
# - For <repo>: starts dockerd (the environment's snapshot keeps files, not processes), adds the fork remote where the repo pushes to a fork, and installs dependencies.
#
# Safe to run more than once.
#
set -euo pipefail

PIPELINE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOME_DIR="$(dirname "$PIPELINE_DIR")"
repo=${1:-}

# It rewrites hooks in every sibling checkout, which on a laptop would be all of ~/code.
if [[ -z ${CCR_AGENT_PROXY_ENABLED:-} && -z ${WPORG_PIPELINE_LOCAL:-} ]]; then
	echo "cloud-setup: not in a cloud session; set WPORG_PIPELINE_LOCAL=1 to run it anyway." >&2
	exit 1
fi

log() { echo "▸ $*" >&2; }

# ── Push guard ──────────────────────────────────────────────────────────────
for git_dir in "$HOME_DIR"/*/.git; do
	[[ -d $git_dir ]] || continue
	cat > "$git_dir/hooks/pre-push" <<'HOOK'
#!/usr/bin/env bash
# Installed by wporg-bug-pipeline: the pipeline only ever pushes claude/* branches.
while read -r local_ref local_sha remote_ref remote_sha; do
	if [[ $remote_ref != refs/heads/claude/* ]]; then
		echo "pre-push: refusing to push $remote_ref; only claude/* branches." >&2
		exit 1
	fi
	if [[ $local_sha =~ ^0+$ ]]; then
		echo "pre-push: refusing to delete $remote_ref." >&2
		exit 1
	fi
done
HOOK
	chmod +x "$git_dir/hooks/pre-push"
done
log "pre-push guard installed in $(ls -d "$HOME_DIR"/*/.git 2>/dev/null | wc -l | tr -d ' ') checkouts"

# ── Toolchain ───────────────────────────────────────────────────────────────
# The setup script installs Node 24 into /usr/local/bin, but the image's /opt/node22/bin comes first on PATH.
active_node=$(command -v node || true)
if [[ -n $active_node && $active_node != /usr/local/bin/node ]] && /usr/local/bin/node -v 2>/dev/null | grep -q '^v24'; then
	for b in node npm npx; do
		[[ -e /usr/local/bin/$b ]] && ln -sf "/usr/local/bin/$b" "$(dirname "$active_node")/$b"
	done
fi
node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
php_minor=$(php -r 'echo PHP_MAJOR_VERSION * 100 + PHP_MINOR_VERSION;' 2>/dev/null || echo 0)
(( node_major >= 24 )) || log "Node $(node -v 2>/dev/null) is older than 24; the environment setup script should install it"
(( php_minor >= 804 )) || log "PHP $(php -r 'echo PHP_VERSION;' 2>/dev/null) is older than 8.4; the environment setup script should install it"

[[ -n $repo ]] || exit 0

# ── Docker ──────────────────────────────────────────────────────────────────
if ! docker info >/dev/null 2>&1; then
	# Anonymous Docker Hub pulls from the shared egress hit 429; the setup script points dockerd at a mirror.
	if [[ ! -f /etc/docker/daemon.json ]]; then
		mkdir -p /etc/docker
		echo '{"registry-mirrors":["https://mirror.gcr.io"]}' > /etc/docker/daemon.json
	fi
	(dockerd > /tmp/dockerd.log 2>&1 &)
	for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done
	docker info >/dev/null 2>&1 && log "dockerd started" || log "dockerd did not start; see /tmp/dockerd.log"
fi
wt="$HOME_DIR/$repo"
[[ -d $wt/.git ]] || { log "no checkout at $wt"; exit 1; }

# ── wp-env base images ──────────────────────────────────────────────────────
# The network proxy re-signs HTTPS, and wp-env's image builds (apk, apt) trust only the CAs in
# their base image. Docker builds FROM a local image of that tag before the registry's, so
# re-tag each wordpress base image the repo's wp-env configs use with the host's CA bundle.
# Sessions run as root, which wp-env passes on to its containers: wp-cli refuses root unless
# WP_CLI_ALLOW_ROOT is set, and Apache refuses to serve as root (APACHE_RUN_USER=#0) and exits,
# so Apache falls back to the image's own www-data. wp-env puts /home/<user>/.composer/vendor/bin
# on PATH and mounts that home, but root's own home is /root, so Composer's home moves there.
ca_bundle=${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}
wp_env_configs=$(find "$wt" -name '.wp-env*.json' -not -path '*/node_modules/*' 2>/dev/null)
if [[ -n $wp_env_configs ]] && docker info >/dev/null 2>&1 && [[ -f $ca_bundle ]]; then
	ctx=$(mktemp -d)
	cp "$ca_bundle" "$ctx/ca.crt"
	# An empty version is wp-env's default, the untagged PHP image.
	while IFS= read -r v; do
		for img in "wordpress${v:+:php$v}" "wordpress:cli${v:+-php$v}"; do
			[[ $(docker image inspect "$img" --format '{{index .Config.Labels "wporg-pipeline"}}' 2>/dev/null) == 4 ]] && continue
			cat > "$ctx/Dockerfile" <<-DOCKERFILE
				FROM $img
				COPY ca.crt /etc/ssl/certs/ca-certificates.crt
				ENV WP_CLI_ALLOW_ROOT=1 COMPOSER_HOME=/home/root/.composer
				RUN if [ -f /etc/apache2/envvars ]; then printf '%s\\n' 'if [ "\$APACHE_RUN_USER" = "#0" ]; then export APACHE_RUN_USER=www-data APACHE_RUN_GROUP=www-data; fi' >> /etc/apache2/envvars; fi
				LABEL wporg-pipeline=4
			DOCKERFILE
			if docker build -q -t "$img" "$ctx" >/dev/null 2>&1; then
				log "$img trusts the proxy CA"; rebuilt=1
			else
				log "could not add the proxy CA to $img"
			fi
		done
	done < <(xargs jq -r '[.phpVersion // ""] + [.env // {} | .[] | .phpVersion | select(.)] | .[]' <<< "$wp_env_configs" 2>/dev/null | sort -u)
	rm -rf "$ctx"
	# A sandbox can be reused: wp-env's images built on the old base, and its state, would outlive the new one.
	if [[ -n ${rebuilt:-} ]]; then
		docker ps -aq | xargs -r docker rm -f >/dev/null 2>&1 || true
		docker image ls --format '{{.Repository}}' | grep -E '.-(tests-)?(wordpress|cli)$' | xargs -r docker rmi -f >/dev/null 2>&1 || true
		rm -rf "${WP_ENV_HOME:-$HOME/.wp-env}"
	fi
fi

# ── Remotes ─────────────────────────────────────────────────────────────────
push_mode=$(jq -r --arg r "$repo" '.repos[$r].push // empty' "$PIPELINE_DIR/repos.json")
[[ -n $push_mode ]] || { log "$repo is not in repos.json"; exit 1; }
if [[ $push_mode == fork ]]; then
	fork_owner=$(jq -r .fork_owner "$PIPELINE_DIR/repos.json")
	owner=$(jq -r .owner "$PIPELINE_DIR/repos.json")
	# Attaching a fork and its upstream yields one checkout whose origin can be either; pin both.
	git -C "$wt" remote set-url origin "https://github.com/$owner/$repo"
	git -C "$wt" remote get-url fork >/dev/null 2>&1 || git -C "$wt" remote add fork "https://github.com/$fork_owner/$repo"
	git -C "$wt" fetch -q origin
fi

# ── Dependencies ────────────────────────────────────────────────────────────
platform_args=()
(( php_minor >= 804 )) || platform_args=(--ignore-platform-req=php)
if [[ -f $wt/composer.lock ]]; then
	log "composer install in $repo"
	# Sessions run as root, where Composer skips plugins unless told otherwise, and the phpcs installer is one.
	(cd "$wt" && COMPOSER_ALLOW_SUPERUSER=1 composer install -q --no-interaction --no-progress "${platform_args[@]+"${platform_args[@]}"}") || log "composer install failed"
fi
for lock in "$wt/package-lock.json" "$wt/environments/package-lock.json"; do
	[[ -f $lock ]] || continue
	log "npm ci in ${lock%/package-lock.json}"
	# A transient registry error once cost a run nine minutes; retry once, bounded.
	for attempt in 1 2; do
		(cd "$(dirname "$lock")" && timeout 300 npm ci --no-audit --no-fund --loglevel=error --fetch-retries=4) && break
		(( attempt == 2 )) && log "npm ci failed twice in $(dirname "$lock")"
	done
done
log "setup done for $repo"
