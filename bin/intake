#!/usr/bin/env python3
#
# intake <repo> [--limit N] [--dry-run] — the items a worker should look at this run, one JSON object per line.
#
# Sources: open GitHub issues on WordPress/<repo> filed after the pipeline started on it, and Meta
# Trac tickets the router sent to <repo>, newest first. The first run records the start time as the baseline.
# An item is left out when another run holds its claim, when someone is assigned to it, or when this
# repo already decided on it and nothing changed on the item since. One that someone else already has
# an open PR or patch for is recorded as skipped, and comes back if that PR closes unmerged.
#
# With the repo's `backlog` enabled in repos.json, the slots new items leave fill with open issues
# filed before the baseline, most recently updated first. Their lines carry "backlog": <mode>. An
# issue with one of the profile's skip_labels is recorded skip "out of scope" here, with no model run.
# In triage mode a ready backlog item stays decided. In fix mode it comes back to be fixed while the
# repo has fewer than max_open_prs open claude/* PRs; its line carries "pr_room", the PRs left under the cap.
# The run's limit is the backlog's batch, or 8 without one.
#
# --dry-run records nothing and prints what it would record to stderr.
# Prints nothing when there is nothing to do; the run can stop there.
#
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

import existing_pr

BIN = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(BIN)
STATE_DIR = os.environ.get('WPORG_STATE_DIR', os.path.expanduser('~/.wporg-state'))
CLAIM_TTL = 4 * 3600
LIMIT = 8
# A run fixes at most this many items (RUNBOOK step 3).
FIXES = 2


def parse_ts(s):
	return datetime.fromisoformat(s.replace('Z', '+00:00')) if s else None


def read(path):
	try:
		with open(os.path.join(STATE_DIR, path)) as f:
			return json.load(f)
	except (FileNotFoundError, json.JSONDecodeError):
		return None


def claim_held(key, item_updated):
	c = read(f'items/{key}/claim.json')
	if not c:
		return False
	if c.get('status') in ('pr-open', 'done'):
		return True
	if c.get('status') == 'working':
		age = (datetime.now(timezone.utc) - parse_ts(c['updated'])).total_seconds()
		return age < CLAIM_TTL
	# A failed fix is retried only once the item changes, not on every run.
	if c.get('status') == 'failed':
		return parse_ts(c['updated']) >= parse_ts(item_updated)
	return False


def decided_since(key, repo, item_updated, fixable=True):
	d = read(f'items/{key}/{repo}.json')
	if not d:
		return False
	# A ready item that did not fit in an earlier run's fix budget comes back until it is claimed.
	if d.get('status') == 'ready' and fixable:
		return False
	if d.get('pr') and existing_pr.pr_state(d['pr']) == 'closed':
		return False
	return parse_ts(d['updated']) >= parse_ts(item_updated)


def issue(repo, i):
	return {
		'key': f"gh-{repo}-{i['number']}",
		'source': 'github',
		'number': i['number'],
		'title': i['title'],
		'updated_at': i['updated_at'],
		'url': i['html_url'],
	}


def github_issues(repo, since):
	out = subprocess.run(
		['gh', 'api', f'repos/WordPress/{repo}/issues?state=open&sort=updated&direction=desc&per_page=100'],
		capture_output=True, text=True,
	)
	if out.returncode != 0:
		print(f'intake: GitHub issues for {repo} unavailable: {out.stderr.strip()}', file=sys.stderr)
		return []
	for i in json.loads(out.stdout):
		if 'pull_request' in i or i.get('assignees') or i['created_at'] <= since:
			continue
		yield issue(repo, i)


def backlog_issues(repo, since):
	"""Open, unassigned issues filed up to the baseline, most recently updated first, each with its label names."""
	out = subprocess.run(
		['gh', 'api', '--paginate', f'repos/WordPress/{repo}/issues?state=open&sort=updated&direction=desc&per_page=100',
			'--jq', '.[] | select((.pull_request | not) and (.assignees | length) == 0) | tojson'],
		capture_output=True, text=True,
	)
	if out.returncode != 0:
		print(f'intake: GitHub backlog for {repo} unavailable: {out.stderr.strip()}', file=sys.stderr)
		return []
	for line in out.stdout.splitlines():
		i = json.loads(line)
		if i['created_at'] <= since:
			yield issue(repo, i), {l['name'] for l in i.get('labels', [])}


def routed_tickets(repo):
	items = os.path.join(STATE_DIR, 'items')
	if not os.path.isdir(items):
		return
	for key in os.listdir(items):
		if not key.startswith('trac-'):
			continue
		r = read(f'items/{key}/route.json')
		if not r or r.get('repo') != repo:
			continue
		yield {
			'key': key,
			'source': 'trac',
			'number': int(key[5:]),
			'title': r.get('summary', ''),
			'updated_at': r.get('ticket_updated') or r['updated'],
			'url': f'https://meta.trac.wordpress.org/ticket/{key[5:]}',
		}


def take(items, n, repo, writes):
	"""The first n items nobody else has an open PR or patch for; the ones passed over are recorded as skipped."""
	listed = []
	for item in items:
		if len(listed) >= n:
			break
		other = existing_pr.for_key(item['key'])
		if other:
			writes.append((f"items/{item['key']}/{repo}.json", {'status': 'skip', 'reason': other[0], 'pr': other[1]}))
			continue
		listed.append(item)
	return listed


def backlog(repo, conf, since, slots, writes):
	mode = conf.get('mode', 'triage')
	skip_labels = set(conf.get('skip_labels', []))
	extra = {'backlog': mode}
	room = 0
	if mode == 'fix':
		open_prs = existing_pr.pipeline_prs(repo)
		# An unknown count is a full one, so a GitHub error cannot push a repo past its cap.
		room = 0 if open_prs is None else max(0, conf.get('max_open_prs', 0) - open_prs)
		extra['pr_room'] = room

	ready, fresh = [], []
	for item, labels in backlog_issues(repo, since):
		key = item['key']
		if claim_held(key, item['updated_at']):
			continue
		if labels & skip_labels:
			if not decided_since(key, repo, item['updated_at'], fixable=False):
				writes.append((f'items/{key}/{repo}.json', {'status': 'skip', 'reason': 'out of scope'}))
			continue
		if decided_since(key, repo, item['updated_at'], fixable=room > 0):
			continue
		d = read(f'items/{key}/{repo}.json')
		(ready if room > 0 and d and d.get('status') == 'ready' else fresh).append(item)

	# Items already triaged ready go first, as many as the run could fix; the rest wait for room.
	listed = take(ready, min(room, FIXES, slots), repo, writes)
	listed += take(fresh, slots - len(listed), repo, writes)
	return [{**item, **extra} for item in listed]


def main():
	args = sys.argv[1:]
	if not args or args[0].startswith('-'):
		sys.exit('Usage: intake <repo> [--limit N] [--dry-run]')
	repo = args[0]
	with open(os.path.join(ROOT, 'repos.json')) as f:
		conf = json.load(f)['repos'].get(repo, {}).get('backlog') or {}
	if not conf.get('enabled'):
		conf = {}
	limit = int(args[args.index('--limit') + 1]) if '--limit' in args else max(LIMIT, conf.get('batch', 0))
	subprocess.run([os.path.join(BIN, 'state'), 'ls', 'items'], capture_output=True, check=True)

	writes = []
	baseline = read(f'baselines/{repo}.json')
	if not baseline:
		baseline = {'since': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}
		writes.append((f'baselines/{repo}.json', baseline))

	found = []
	for item in list(routed_tickets(repo)) + list(github_issues(repo, baseline['since'])):
		if claim_held(item['key'], item['updated_at']) or decided_since(item['key'], repo, item['updated_at']):
			continue
		found.append(item)
	found.sort(key=lambda i: i['updated_at'], reverse=True)
	listed = take(found, limit, repo, writes)
	if conf and len(listed) < limit:
		listed += backlog(repo, conf, baseline['since'], min(conf.get('batch', limit), limit - len(listed)), writes)

	if writes:
		lines = ''.join(f'{path}\t{json.dumps(data)}\n' for path, data in writes)
		if '--dry-run' in args:
			print(f'intake: would record {len(writes)} files:\n{lines}', end='', file=sys.stderr)
		else:
			subprocess.run([os.path.join(BIN, 'state'), 'put-many'], input=lines, capture_output=True, text=True, check=True)
	for item in listed:
		print(json.dumps(item))


main()
