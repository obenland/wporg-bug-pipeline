#!/usr/bin/env bash
#
# preflight <repo|router|shepherd> — the first and, on most runs, only thing a routine does.
#
# Installs the push guard, then asks intake whether there is any work. With none, it records the
# run and prints IDLE as its last line, so the session can end before reading a runbook or
# installing dependencies. Otherwise it prints the candidates and WORK. When intake could not read
# a source and found nothing else, it prints ERROR and exits 1 without recording the run.
#
set -euo pipefail

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
target=${1:?Usage: preflight <repo|router|shepherd>}
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

command -v jq >/dev/null || apt-get install -y -qq jq >/dev/null
"$BIN/cloud-setup" >/dev/null

if [[ $target == router ]]; then
	work=$("$BIN/router-intake" --limit 15)
elif [[ $target == shepherd ]]; then
	work=$("$BIN/shepherd-intake" --limit 4)
else
	status=0
	work=$("$BIN/intake" "$target") || status=$?
	(( status == 0 || status == 3 )) || exit "$status"
	if (( status == 3 )) && [[ -z $work ]]; then
		echo "ERROR: intake could not read GitHub for $target (see above), so this run cannot tell whether there is work."
		exit 1
	fi
fi

if [[ -z $work ]]; then
	[[ $target == router ]] || "$BIN/state" put "runs/$target.json" "$(jq -n --arg ts "$now" '{last_run: $ts}')"
	echo IDLE
else
	printf '%s\n' "$work"
	echo WORK
fi
