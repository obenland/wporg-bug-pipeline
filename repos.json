				{
					"name": "composer install",
					"run": "composer install || composer update wporg/*"
				},
				{
					"name": "yarn install",
					"run": "yarn"
				},
				{
					"name": "Setup tools",
					"run": "yarn setup:tools"
				},
				{
					"name": "Build",
					"run": "yarn workspaces run build"
				},
				{
					"name": "Lint CSS",
					"run": "yarn workspaces run lint:css"
				},
				{
					"name": "Lint JS",
					"run": "yarn workspaces run lint:js"
				},
				{
					"name": "Lint PHP",
					"run": "yarn run lint:php",
					"note": "the script is `echo \"No PHP lint.\"`, a no-op"
				},
				{
					"name": "Install WordPress",
					"run": "curl -sSL https://wordpress.org/nightly-builds/wordpress-latest.zip -o /tmp/wordpress.zip && unzip -q -o /tmp/wordpress.zip -d /tmp && { test -d /tmp/wordpress-develop || { git clone -q --depth=1 --filter=blob:none --sparse https://github.com/WordPress/wordpress-develop /tmp/wordpress-develop && git -C /tmp/wordpress-develop sparse-checkout set tests/phpunit/includes tests/phpunit/data; }; }",
					"note": "as CI's Install WordPress step; PHPUnit also needs MySQL at 127.0.0.1 (root/root) with a wordpress_test database"
				},
				{
					"name": "PHPUnit",
					"run": "WP_CORE_DIR=/tmp/wordpress WP_TESTS_DIR=/tmp/wordpress-develop/tests/phpunit WP_TESTS_CONFIG_FILE_PATH=\"$PWD/.github/wp-tests-config.php\" vendor/bin/phpunit",
					"note": "not wp-env: CI uses the runner's MySQL (root/root@127.0.0.1, db wordpress_test), the nightly WordPress zip unpacked to /tmp/wordpress and a sparse wordpress-develop checkout (tests/phpunit/includes + data) at /tmp/wordpress-develop. Path-filtered to source/**, phpunit.xml.dist, composer.*, .github/wp-tests-config.php"
				}
			],
			"backlog": {
				"enabled": true,
				"mode": "fix",
				"skip_labels": [],
				"max_open_prs": 3,
				"batch": 25
			}
		},
