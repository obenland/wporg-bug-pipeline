					"name": "Lint CSS",
					"run": "npm run lint:css --workspaces --if-present"
				},
				{
					"name": "Lint non-workspace CSS",
					"run": "npx stylelint 'public_html/wp-content/themes/groups-site/assets/css/*.css' 'public_html/wp-content/mu-plugins/gatherpress-recurring-events/assets/*.css'"
				},
				{
					"name": "Lint PHP (changed lines)",
					"run": "BASE_REF=production php .github/bin/phpcs-branch.php"
				},
				{
					"name": "JS unit tests",
					"run": "npm run test --workspace=wordcamp-blocks && npm run test --workspace=wporg-groups-frontend"
				},
				{
					"name": "Install WP test suite",
					"run": "bash .docker/bin/install-wp-tests.sh wcorg_test root root 127.0.0.1:3306 latest true",
					"note": "needs a local MariaDB/MySQL (CI uses a mariadb:lts service, root/root, db wcorg_test, on a mapped port)"
				},
				{
					"name": "Install GatherPress",
					"run": "curl -sL https://github.com/GatherPress/gatherpress/releases/download/0.36.2/gatherpress.0.36.2.zip -o /tmp/gatherpress.zip && unzip -q -o /tmp/gatherpress.zip -d public_html/wp-content/plugins/"
				},
				{
					"name": "PHPUnit",
					"run": "./public_html/wp-content/mu-plugins/vendor/bin/phpunit -c phpunit.xml.dist",
					"note": "CI shards by --testsuite across PHP 8.3/8.4/8.5 ('WordCamp Groups' / 'WordCamp Groups Network,WordCamp MU Plugins' / all others); no --testsuite runs them all. Needs wporg-groups-frontend built (covered by the Build step)"
				}
			],
			"checks_note": "The Playwright E2E workflow needs a scripted Docker environment and is left out; it runs only for changes under the groups code.",
			"backlog": {
				"enabled": true,
				"mode": "triage",
				"skip_labels": [
